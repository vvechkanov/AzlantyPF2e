# Лужи — доска давления (Арка 2)
# Один вопрос: какие силы в районе и кто на кого жмёт.
# Кампанийные стыки и нити PC — в 00__HUB.d2.
# Запуск:  cd "C:\DND\sync\Sync\Obsidian\PF2e\Кампейны\Азланти\Golarion\Абсалом\Районы\Puddles" && d2 -w 00__Лужи.d2

direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 60
  }
}

classes: {
  pressure: {
    style.stroke: "#555555"
    style.stroke-width: 3
  }
  pressure-soft: {
    style.stroke: "#999999"
    style.stroke-width: 2
    style.stroke-dash: 5
  }
  sq: {
    style.stroke: "#e8730a"
    style.stroke-width: 4
  }
}

Legend: "🧭 ━━ открытое давление  ╌╌ скрытое/договор  🟧 вход партии" {
  style.fill: "#fdf6e3"
  style.font-size: 16
  near: top-center
}

# ============================================================
# 6 СИЛ
# ============================================================

Khaigen: "🏛️ ХАЙГЕН ТОПКИК\nформальная власть, теряет контроль\nштаб: Stilt House" {
  style.fill: "#e0e0e0"
  style.font-size: 20
  style.bold: true
}
Seychia: "🩸 ЛЕДИ СЕЙЧИЯ — Salt Cartel\nработорговля; Brine тонет → ищет канал\nштаб: Brine" {
  style.fill: "#d4c5e2"
  style.font-size: 20
  style.bold: true
}
Skinsaw: "🗡️ SKINSAW CULT\nтеррор Норгорбера\nхрам: Razorhall" {
  style.fill: "#f8b4b4"
  style.font-size: 20
  style.bold: true
}
Zusgut: "🟢 ЗУСГУТ\nгоблинская коммуна, растёт снизу\nдвор: Goblin King's Court" {
  style.fill: "#c8e6c9"
  style.font-size: 20
  style.bold: true
}
Syrvas: "🔴 КРУГ SYRVAS\nтихая витрина — ТОЛЬКО ДОБРО [Арка 2]\nлицо: Хоуп / Приют Чистой Воды" {
  style.fill: "#fde8e8"
  style.font-size: 20
  style.bold: true
}
Annavi: "💰 АННАВИ\nэконом. узел в петле, ищет защитника\nрынок: Barque Bazaar" {
  style.fill: "#fff9c4"
  style.font-size: 20
  style.bold: true
}

Lemaria: "🎯 Лемария Кумари\n(мишень Skinsaw)" {
  style.fill: "#ffe0e0"
  style.stroke-dash: 3
}

# ============================================================
# ДАВЛЕНИЕ
# ============================================================

Khaigen -> Zusgut: "штурм Двора (2-3 мес)" {class: pressure}
Khaigen -> Annavi: "'слияние' или утонешь" {class: pressure}
Seychia -- Khaigen: "договор; молчание\nМакракеров за долю" {class: pressure-soft}
Seychia -> Annavi: "долги / 'деловая защита'" {class: pressure}
Skinsaw -> Lemaria: "показательное убийство" {class: pressure}
Skinsaw -> Khaigen: "хаос подрывает\nего 'порядок'" {class: pressure-soft}
Zusgut -> Khaigen: "рост = угроза монополии" {class: pressure-soft}
Syrvas -> Annavi: "может стать защитником" {class: pressure-soft}
Syrvas -> Khaigen: "тихо подбирает власть" {class: pressure-soft}
Syrvas -> Zusgut: "помощь, если\nХайген ударит" {class: pressure-soft}

# ============================================================
# ВХОД ПАРТИИ (только метка; начинка — в райтапе SQ1)
# ============================================================

SQ1: "🟧 SQ1 — «Щупальца у приюта»\n(клик — открыть райтап)" {
  link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/Golarion/Абсалом/Районы/Puddles/События/SQ1__Щупальца_у_приюта"
  style.fill: "#ffe8cc"
  style.stroke: "#e8730a"
  style.stroke-width: 3
  style.font-size: 16
  style.bold: true
}
Seychia -> SQ1: "сироты как 'товар'" {class: sq}
SQ1 -> Syrvas: "угроза приюту" {class: sq}

# ============================================================
# ПРОГНОЗ: ЧЕРЕЗ 2-3 МЕС БЕЗ ПАРТИИ
# ============================================================

Forecast: "⏳ ЧЕРЕЗ 2-3 МЕС БЕЗ ПАРТИИ\nХайген штурмует Зусгута • Сейчия → открытые хватания\nSkinsaw убивают Лемарию • Круг подбирает куски → власть" {
  style.fill: "#fff0f0"
  style.stroke: "#c0392b"
  style.font-size: 16
  style.bold: true
  near: bottom-center
}
