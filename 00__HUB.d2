# Азланти — Абсалом, Арка 2
# Запуск:  d2 -w 00__HUB.d2

direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 60
  }
}

classes: {
  thread-plates: {
    style.stroke: "#4a90a4"
    style.stroke-width: 4
  }
  thread-plates-hidden: {
    style.stroke: "#4a90a4"
    style.stroke-width: 4
    style.stroke-dash: 5
  }
  thread-anchanto: {
    style.stroke: "#d4a017"
    style.stroke-width: 4
  }
  thread-statue: {
    style.stroke: "#9c6da8"
    style.stroke-width: 4
  }
  thread-statue-hidden: {
    style.stroke: "#9c6da8"
    style.stroke-width: 4
    style.stroke-dash: 5
  }
}

# ============================================================
# ROOT — ОБЗОР
# ============================================================

Sources: "🌱 Входные нити" {
  style.fill: "#fdf6e3"
  style.font-size: 26
  style.bold: true

  Tosha: "Учёный-старик\n(для Самума)" {
    link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/PC/Самум (Тоша)"
  }
  Bell: "Бель — попаданка" {
    link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/PC/Бель (Настя)"
  }
  Anchanto: "История Анканто\n(природа меча)" {
    link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/PC/Анканто"
  }
  Luka: "Лука Блакрос\n(спасён партией;\nне знает что Блакрос)"
  Kiran_statue: "Статуэтка 'Ирори'\n(на самом деле — реликвия\nХоломога, унесена в 4329 AR;\nв монастыре ~400 лет)\n🟪"
  Plates: "Пластины Азланти\n(×2)"
  Merra: "Мерра — Норгорберша\n(беженка из Гринфорда)"
}

