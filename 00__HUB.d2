  style.fill: "#d3e8df"
  style.font-size: 28
  style.bold: true
}

# === ЭКСПЕРТЫ ПРИРОДЫ АНКАНТО (нить Анканто) ===

Enyar: "🧠 Эньяр Серравек\n(Безумный учёный, Coins)\nрезонатор; тупик-зеркало\nдля Кирана\n🟨" {
  style.fill: "#f5e6c8"
  style.font-size: 26
  style.bold: true
  link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Эньяр Серравек"
}

SectAgent: "🎭 Представитель Секты\n(под прикрытием,\nимя TBA)\n🟨" {
  style.fill: "#f5e6c8"
  style.font-size: 26
  style.bold: true
}

# === ДАЛЬНЯЯ ЗЕМЛЯ (нить статуэтки) ===

Holomog: "🌍 Холомог\n(матриархат, юг Гарунда)\nдалёкая земля\n[Арка 3+]\n🟪" {
  style.fill: "#e8d5a8"
  style.stroke-dash: 5
  style.font-size: 26
  style.bold: true
}

# === СВЯЗИ НА ОБЗОРНОМ УРОВНЕ ===

# Входные нити (общие)
Sources.Tosha -> Arcanamirium
Sources.Bell -> Library
Sources.Merra -> Puddles

# Покупатели пластин (продажа — другая нить)
Sources.Plates -> HouseBlakros: "покупатель\n(в музей)"
Sources.Plates -> HouseOrmuz: "покупатель"

# === НИТЬ ОТКРЫТИЯ ДВЕРИ (лазурный) ===

Sources.Plates -> Arcanamirium: "путь к эксперту" {class: thread-plates}
Sources.Plates -> Library: "путь к эксперту" {class: thread-plates}
Sources.Plates -> Pathfinders: "путь к эксперту" {class: thread-plates}
Sources.Plates -> Syrvas: "через посредников\n(быстро / без лута)" {class: thread-plates-hidden}

Arcanamirium -> Sarel: "через старика-Арклорда" {class: thread-plates}
Library -> Sarel: "архивист знаком" {class: thread-plates}
Library -> Pathfinders: "архивист направит" {class: thread-plates}
Pathfinders -> Arcanamirium: "рекомендация к Ориху\n(Эксперт-2)" {class: thread-plates}
Pathfinders -> Sarel: "Зарта знает" {class: thread-plates}

# === НИТЬ ПРИРОДЫ АНКАНТО (золотой) ===

Sources.Anchanto -> HouseOfHealing: "к Дорису от Варена" {class: thread-anchanto}

HouseOfHealing -> Enyar: "Дорис: 'есть\nстранный исследователь'" {class: thread-anchanto}
HouseOfHealing -> HouseBlakros: "Дорис: 'у Блакросов\nколлекция'" {class: thread-anchanto}

# Параллельные пути минуя Дориса
Arcanamirium -> Enyar: "бывший доцент" {class: thread-anchanto}
Pathfinders -> SectAgent: "консультант по\nдревним оружиям" {class: thread-anchanto}
HouseOrmuz -> HouseBlakros: "светский салон\n→ Хамария" {class: thread-anchanto}

# === НИТЬ СТАТУЭТКИ (сиреневая) ===
# Реликвия Холомога, ~400 лет в монастыре Mirror Water.
# В Арке 2 — только зацепки. В Арке 3+ — полноценный поход.

Sources.Kiran_statue -> Iroriarum: "Йсия знала Аширу" {class: thread-statue}
Sources.Kiran_statue -> Puddles: "беженка узнаёт\nстиль" {class: thread-statue}
Sources.Kiran_statue -> Library: "архивы Forae Logos" {class: thread-statue}
Sources.Kiran_statue -> Sarel: "видел узлы пояса\n(страховка)" {class: thread-statue}
Iroriarum -> Library: "Йсия → Лисенг" {class: thread-statue}
Puddles -> Holomog: "след → дальняя земля" {class: thread-statue-hidden}
Library -> Holomog: "след → дальняя земля" {class: thread-statue-hidden}

# === НИТЬ ПОПАДАНЧЕСТВА БЕЛЬ × ПРОИЗНОШЕНИЕ ===
# Бель произносит азлантийский так же, как Сарел Тейваниэль (альт. школа).
# Зарта услышала характерный сигнал, ошибочно сочла Бель ученицей Сарела.
# На самом деле Бель его не знает — намёк на мост миров через язык. Загадка не закрыта.

Sources.Bell -> Sarel: "одинаковое произношение\n(Бель не его ученица)" {class: thread-plates-hidden}

# Связи между большими сущностями
HouseOfHealing -- HouseOrmuz: знакомство
HouseOfHealing -- Puddles: "Дорис координирует;\nХоуп там работает"
HouseOrmuz -- HouseBlakros: конкуренция
HouseOrmuz -- Arcanamirium: меценат

# Скрытое от партии
HouseOrmuz -- Syrvas: донор {style.stroke-dash: 5}
HouseDamak -- Syrvas: донор {style.stroke-dash: 5}
Syrvas -- Puddles: "тихая витрина\nчерез Хоуп" {style.stroke-dash: 5}

# ============================================================
# LAYERS
# ============================================================

layers: {

  ormuz: {
    direction: down

    Ormuz: "🏛️ Дом Ормуз" {
      style.fill: "#e8f1fb"
      style.font-size: 32
      style.bold: true

      Yamtar: "Лорд Ямтар\nмеценат / салоны" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Лорд Ямтар (Дом Ормуз)"
      }
      Kaisar: "Кайсар\nдолг 50 зм" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Кайсар Ормуз"
      }
      Yamtar -- Kaisar
    }

    PlatesIntel: "💡 Инсайт:\nподобные пластины открывают\nдоступы к механизмам\n(скажет Ямтару — кто?)" {
      style.fill: "#fff8d0"
      style.stroke: "#c9a227"
    }

    Doris_ext: "🕊️ Дорис Кай\n(Дом Исцеления) →" {
      style.fill: "#fff3b0"
      link: layers.house_of_healing
    }
    Blakros_ext: "🏛️ Дом Блакрос →" {
      style.fill: "#e8f1fb"
      link: layers.blakros
    }
    Arcana_ext: "📚 Арканамириум →" {
      style.fill: "#efe6f7"
      link: layers.arcana
    }
    Elarion_ext: "🔴 Эларион Меретис\n(Круг Syrvas) →" {
      style.fill: "#fde8e8"
      link: layers.syrvas
    }

    Ormuz.Yamtar -- Doris_ext: "знаком лично"
    Ormuz.Yamtar -- Blakros_ext: "конкуренция за\nджистканские артефакты"
    Ormuz.Yamtar -- Arcana_ext: "покровитель\nисследователей"
    Ormuz.Yamtar -- Elarion_ext: "советник на салонах\n(скрыто)" {
      style.stroke-dash: 5
    }
    Ormuz.Yamtar -- PlatesIntel: "новый интерес\n→ покупатель пластин"
  }

  blakros: {
    direction: down

    Blakros: "🏛️ Дом Блакрос\n(Wise Quarter / Petal District)" {
      style.fill: "#e8f1fb"
      style.font-size: 32
      style.bold: true
      link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/Сюжет кампании/Глобальные фракции/Дом Блакрос"

      Hamaria: "👑 Хамария Блакрос\nScion Lady (~55)\n[высокая фигура]" {
        style.fill: "#fff8d0"
        style.bold: true
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Хамария Блакрос"
      }
      Nigel: "Найджел Олдейн\nкуратор Музея\nбывший Pathfinder\n[главный контакт партии]" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Найджел Олдейн"
      }
      Dhrami: "Lady Dhrami\nжена Найджела\nхудожница, owner of record" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Lady Dhrami Blakros"
      }
      Encarius: "Lord Encarius\nучитель рисунка\nсплетник Petal" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Lord Encarius Blakros"
      }
      Michellia: "Lady Michellia\nдочь Хамарии\nнаследница\n[резерв]" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Lady Michellia Blakros"
      }
      Oved: "Lord Oved\nлошадник Petal\n[резерв]" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Lord Oved Blakros"
      }
      Alkandros: "Лорд Алкандрос Блакрос\nфинансист и скупщик\nполуорк, ~39\n[кредитор Кайсера + отец Луки]" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Алкандрос Блакрос"
      }

      Museum: "📿 Blakros Museum\n(Wise Quarter)" {
        style.fill: "#efe6f7"
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/Golarion/Абсалом/Районы/Wise Quarter/Локации/Blakros Museum"
      }
      Castle: "🏰 Castle Blakros\n(Petal District)\n+ глефа в галерее" {
        style.fill: "#efe6f7"
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/Golarion/Абсалом/Районы/Petal District/Castle Blakros"
      }

      # Внутренние связи
      Hamaria -> Michellia: "наследница" {style.stroke-dash: 3}
      Hamaria -- Nigel: "куратор её Музея;\nдоверие, не дружба"
      Hamaria -- Castle: "резиденция"
      Hamaria -- Museum: "публичное лицо"
      Hamaria -- Alkandros: "финансист дома"
      Nigel -- Dhrami: "брак"
      Nigel -- Museum: "управляет"
      Dhrami -- Museum: "owner of record"
      Dhrami -- Encarius: "наняла учителя"
    }

    # === Внешние сущности ===
    Ormuz_ext: "🏛️ Дом Ормуз →" {
      style.fill: "#e8f1fb"
      link: layers.ormuz
    }
    Kaisar_ext: "Кайсар Ормуз →\nдолжник\n(одна из расписок)" {
      style.fill: "#e8f1fb"
      link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Кайсар Ормуз"
    }
    Yamtar_ext: "🏛️ Лорд Ямтар →" {
      style.fill: "#e8f1fb"
      link: layers.ormuz
    }
    Pathfinders_ext: "🗺️ Pathfinder Society →\nстарые связи Найджела;\nХамария укрепляет" {
      style.fill: "#efe6f7"
      link: layers.pathfinders
    }
    Library_ext: "📖 Forae Logos →" {
      style.fill: "#efe6f7"
      link: layers.library
    }
    Anchanto_src: "Анканто (Сеня)\n[резонирует с молотом]" {
      style.fill: "#fdf6e3"
    }
    Sect_ext: "🔴 Секта Визиря →\nХамария — невольная\nпокровительница (скрыто)" {
      style.fill: "#fde8e8"
    }
    Plates_src: "Пластины Азланти" {
      style.fill: "#fdf6e3"
    }
    EdnaLuka_src: "Эдна / Лука\n(Гринфорд, Арка 1)\n🟨" {
      style.fill: "#fdf6e3"
    }

    # === Внешние связи ===
    Blakros.Hamaria -- Yamtar_ext: "конкуренция за\nджистканские артефакты"
    Blakros.Hamaria -- Pathfinders_ext: "укрепляет связь;\nможет дать рекомендацию\nв закрытую секцию Forae"
    Blakros.Nigel -- Pathfinders_ext: "отстранён;\nтёплеет к младшим"
    Blakros.Nigel -- Library_ext: "еженедельно у Кила"
    Blakros.Alkandros -- Kaisar_ext: "кредитор\n(одна из расписок,\n300 gp с 4724 AR)"
    Blakros.Alkandros -- EdnaLuka_src: "отец Луки\n(не знает; Эдна\nне знает имени)"
    Anchanto_src -> Blakros.Museum: "резонанс с молотом" {class: thread-anchanto}
    Blakros.Castle -- Sect_ext: "глефа = оригинал;\nцентральная сцена\nраскрытия" {class: thread-anchanto}
    Plates_src -> Blakros.Museum: "покупатель;\nдля музея" {class: thread-plates}
  }

  damak: {
    direction: down

    Damak: "🏛️ Дом Дамак" {
      style.fill: "#e8f1fb"
      style.font-size: 32
      style.bold: true

      Head: "Глава (TBA)"
      Money: "деньги"
      Logistics: "логистика"
      Head -- Money
      Head -- Logistics
    }

    Syrvas_ext: "🔴 Круг Syrvas →" {
      style.fill: "#fde8e8"
      link: layers.syrvas
    }

    Damak.Head -- Syrvas_ext: "донор (скрыто)" {style.stroke-dash: 5}
  }

  arcana: {
    direction: down

    Arcanamirium: "📚 Арканамириум\n(Wise Quarter)" {
      style.fill: "#efe6f7"
      style.font-size: 32
      style.bold: true
      link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/Golarion/Абсалом/Районы/Wise Quarter/Локации/Арканамириум"

      # === Двоевластие ===
      Darchana: "👑 Леди Дархана\nАрхдекан, Second Spell Lord\nдом Мадинани\n[высокая фигура]" {
        style.fill: "#fff8d0"
        style.bold: true
      }
      Vannessir: "Метадама Ваннессир\nSergeant-at-Wands\nLE, Asmodean, House Tevineg\n[тёмный канал]" {
        style.fill: "#fde8e8"
      }

      # === Совет Магистров (узлы) ===
      Sornirella: "👑 Магистр Сорнирелла Венах\nMagical Theory\nэльф ~520, центр долгожителей\n[главный хаб партии]" {
        style.fill: "#fff8d0"
        style.bold: true
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Сорнирелла Венах"
      }
      Orikh: "Магистр Айм Калеш Орих\nRelic Studies, полу-куфирец ~45\n[Эксперт-2 для пластин]" {
        style.fill: "#fff8d0"
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Айм Калеш Орих"
      }
      OtherMasters: "Прочие Магистры\nВелланир Ло (A&E)\nКуэнтис Дадар (Fab)\nХедрик Морраск (Trans)\nИзаэль Тенор (Perf)\nХестарий Брен (Battle, в тени Ваннессир)"

      # === Стипендиатка-проводник ===
      Timassa: "Тимасса Кенвар\nстипендиатка Сорниреллы\nполугнумка ~28\n[проводник партии]" {
        link: "obsidian://open?vault=PF2e&file=Кампейны/Азланти/NPC/Тимасса Кенвар"
      }

      # === Параллельный аппарат ===
      Dolmen: "Долмен Ивест\nХранитель Библиотеки\nполугном ~150\n[канал к Эньяру]"
      Ogdyr: "Доцент Огдыр Свен\nпривратник у ворот\n[первая встреча партии]"
      Captain: "Капитан Тира Морин\nСтража, подчинена Архдекану"
      Bursar: "Силеста Кнар (Бурсар)\nЭверин Скалл (Прокуратор)\nАриса Топ (Регистратор)"

      # === Фракция долгожителей ===
      LongLived: "🟢 Тихая фракция долгожителей\nТейваль Колларис (~700, отставка)\nИора (~190, отставка)\n2-3 человека-маги с продлением"

      # === Внутренние связи ===
      Darchana -- Vannessir: "двоевластие;\nне могут снять друг друга"
      Darchana -- Captain: "Капитан Стражи\nподчинена напрямую"
      Darchana -- OtherMasters: "лоялисты\n(Велланир, Куэнтис, Хедрик)"
      Vannessir -- Orikh: "дала tenure;\nформально лоялист"
      Vannessir -- OtherMasters: "Хестарий — её ставленник"
      Vannessir -- Bursar: "учебная вертикаль"
      Sornirella -> LongLived: "центр фракции"
